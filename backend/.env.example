# ── ATLAS backend configuration ──────────────────────────────
# Copy to .env and adjust. Every service runs on localhost only.

# Ollama — llama3.2:3b is fast on 8 GB machines; use llama3.1 (8B) with 16 GB+
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Whisper (tiny | base | small | medium | large-v3) — tiny is fastest
WHISPER_MODEL=tiny

# Piper voice model (.onnx). Download via scripts/setup.sh
PIPER_VOICE=models/en_US-ryan-high.onnx

# SQLite database file
DATABASE_PATH=data/atlas.db

# Directories ATLAS may browse and search (comma-separated absolute paths).
# Empty = file access disabled. Add the folders you want the agent to reach,
# e.g. your Desktop / Documents / Downloads. NEVER add system directories.
# macOS example:  /Users/<you>/Desktop,/Users/<you>/Documents,/Users/<you>/Downloads
# Windows example: C:\Users\<you>\Desktop,C:\Users\<you>\Downloads
ALLOWED_SEARCH_ROOTS=

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000
